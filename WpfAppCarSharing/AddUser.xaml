<Page x:Class="WpfAppCarSharing.AddUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppCarSharing"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddUser"
      Background="Azure">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,150,0">
            <TextBox Name="FirstNameAdd" Text="Введите Имя" 
                     Foreground="Gray" Background="AliceBlue"
                     Height="30" VerticalContentAlignment="Center" FontSize="18"
                     Margin="3.5"/>
            <TextBox Name="LastNameAdd" Text="Введите Фамилию" 
                     Foreground="Gray" Background="AliceBlue"
                     Height="30" VerticalContentAlignment="Center" FontSize="18"
                     Margin="3.5"/>
            <TextBox Name="LoginAdd" Text="Введите Логин" 
                     Foreground="Gray" Background="AliceBlue"
                     Height="30" VerticalContentAlignment="Center" FontSize="18"
                     Margin="3.5"/>
            <TextBox Name="PasswordAdd" Text="Введите Пароль" 
                     Foreground="Gray" Background="AliceBlue"
                     Height="30" VerticalContentAlignment="Center" FontSize="18"
                     Margin="3.5"/>

        </StackPanel>
        <Button x:Name="ConfirmAddUser" Content="Добавить" FontSize="20" FontWeight="DemiBold" Grid.Row="1" IsDefault="True"
                Foreground="Aqua" Background="LightYellow" BorderBrush="Gray"
                Width="160" Height="40"  HorizontalAlignment="Center" Click="ConfirmAddUser_Click"/>

    </Grid>
</Page>
