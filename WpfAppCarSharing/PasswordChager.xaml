<Page x:Class="WpfAppCarSharing.PasswordChager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppCarSharing"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PasswordChager"
    >
    <Page.Resources>
        <!-- Цвета для контраста с Azure -->
        <SolidColorBrush x:Key="ButtonPrimary" Color="#007ACC"/>
        <!-- Глубокий синий -->
        <SolidColorBrush x:Key="ButtonHover" Color="#005A9E"/>
        <SolidColorBrush x:Key="AccentAqua" Color="#00FFFF"/>

        <!-- Общий стиль для TextBox и PasswordBox -->
        <Style x:Key="InputBaseStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ADB9CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Применяем стиль к TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Применяем стиль к PasswordBox -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контрастная кнопка -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="demiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="DeepSkyBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="СМЕНА ПАРОЛЯ" Grid.Row="0" 
                   FontSize="35"   
          
            FontWeight="DemiBold"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1">
            <Grid >
            <PasswordBox x:Name="OldPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="15"
                     
                         PasswordChanged="OldPassword_PasswordChanged"/>
            <TextBlock x:Name="lblOldPassword" Text="Введите старый пароль:" HorizontalAlignment="Center" Margin="10,10,145,10"   IsHitTestVisible="False"/>
            </Grid>

            <Grid >
                <PasswordBox x:Name="NewPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="15"
                    
                             PasswordChanged="NewPassword_PasswordChanged"/>
                <TextBlock x:Name="lblNewPassword" Text="Придумайте новый пароль:" HorizontalAlignment="Center" Margin="10,10,125,10"  IsHitTestVisible="False"/>
            </Grid>

            <Grid >
                <PasswordBox x:Name="RepeatNewPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="15"
                     
                             PasswordChanged="RepeatNewPassword_PasswordChanged"/>
                <TextBlock x:Name="lblRepeatNewPassword" Text="Повторите новый пароль:" HorizontalAlignment="Center" Margin="10,10,135,10" IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <Button x:Name="ConfirmNewPassword" Content="Подтвердить" FontWeight="DemiBold" FontSize="15" Grid.Row="2"
                Margin="10"
                Height="40" Width="170"
                HorizontalAlignment="Center"
               
                IsDefault="True" 
                Click="ConfirmNewPassword_Click" />
    </Grid>
</Page>
