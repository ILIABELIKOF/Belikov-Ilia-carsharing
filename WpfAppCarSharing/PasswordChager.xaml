<Page x:Class="WpfAppCarSharing.PasswordChager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppCarSharing"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PasswordChager"
      Background="Azure">
       
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="СМЕНА ПАРОЛЯ" Grid.Row="0" 
                   FontSize="35"   
            Foreground="Aqua"  
            FontWeight="DemiBold"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1">
            <Grid Height="40" Width="290" Margin="25">
            <PasswordBox x:Name="OldPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="18"
                     Foreground="Gray" Background="AliceBlue" BorderBrush="Gray"
                         PasswordChanged="OldPassword_PasswordChanged"/>
            <TextBlock x:Name="lblOldPassword" Text="Введите старый пароль:" HorizontalAlignment="Center" Margin="10,10,145,10" Foreground="Gray"/>
            </Grid>

            <Grid Height="40" Width="290">
                <PasswordBox x:Name="NewPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="18"
                     Foreground="Gray" Background="AliceBlue" BorderBrush="Gray"
                             PasswordChanged="NewPassword_PasswordChanged"/>
                <TextBlock x:Name="lblNewPassword" Text="Придумайте новый пароль:" HorizontalAlignment="Center" Margin="10,10,125,10" Foreground="Gray"/>
            </Grid>

            <Grid Height="40" Width="290" Margin="-3">
                <PasswordBox x:Name="RepeatNewPassword" 
                     HorizontalAlignment="Center" 
                      Width="280" Height="30" 
                      FontSize="18"
                     Foreground="Gray" Background="AliceBlue" BorderBrush="Gray"
                             PasswordChanged="RepeatNewPassword_PasswordChanged"/>
                <TextBlock x:Name="lblRepeatNewPassword" Text="Повторите новый пароль:" HorizontalAlignment="Center" Margin="10,10,135,10" Foreground="Gray"/>
            </Grid>
        </StackPanel>

        <Button x:Name="ConfirmNewPassword" Content="Подтвердить" FontWeight="Bold" FontSize="14" Grid.Row="2"
                Margin="10"
                Height="40" Width="170"
                HorizontalAlignment="Center"
                Foreground="Aqua" Background="LightYellow" BorderBrush="Gray"
                IsDefault="True" 
                Click="ConfirmNewPassword_Click" />
    </Grid>
</Page>
