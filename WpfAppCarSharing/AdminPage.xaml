<Page x:Class="WpfAppCarSharing.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppCarSharing"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage"
      Background="Azure">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="10">
            <DataGrid x:Name="TableOfUsers" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" Margin="0"   >
                <DataGrid.Columns>
                    <DataGridTextColumn  Header="Фамилия" Binding="{Binding LastName}"  />
                    <DataGridTextColumn  Header="Имя" Binding="{Binding FirstName}"  />
                    <DataGridTextColumn  Header="Роль" Binding="{Binding Role}"  />
                    <DataGridTextColumn  Header="Логин" Binding="{Binding login}"  />
                    <DataGridTextColumn  Header="Заблокирован?" Binding="{Binding IsLocked}"  />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        
        
        <Button x:Name="ToAdd" Content="Добавить Нового Пользователя" FontSize="15" FontWeight="DemiBold" Grid.Row="1" 
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Width="250" Height="40"
                Foreground="Aqua" Background="LightYellow" BorderBrush="Gray"
                Margin="15,0" Click="ToAdd_Click"/>

        <Button x:Name="ForUnban" Content="Разблокировать Пользователя" FontSize="15" FontWeight="DemiBold" Grid.Row="1" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="250" Height="40"
                Foreground="Aqua" Background="LightYellow" BorderBrush="Gray"
                Margin="0,0" Click="ForUnban_Click"/>
    </Grid>
</Page>
