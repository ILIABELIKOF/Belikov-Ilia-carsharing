<Page x:Class="WpfAppCarSharing.AUTH_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppCarSharing"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация"
      Background="Azure">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>



        <TextBlock Text="Авторизация" Grid.Row="0" 
            FontSize="35"   
            Foreground="Aqua"  
            FontWeight="DemiBold"
            Width="235"
            HorizontalAlignment="Center"
            Margin="0,0,0,0"
             />
        <StackPanel Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Width="300" >

            <!--<TextBlock Text="Логин:"   HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>-->
            <TextBox x:Name="txtUsername" Text="Логин" FontSize="18"
                     Height="30" Width="250" 
                     VerticalAlignment="Center"
                     Foreground="Gray" Background="AliceBlue" BorderBrush="Gray"
                     Margin="0,5,0,10"
                     GotFocus="txtUsername_GotFocus"
                     LostFocus="txtUsername_LostFocus" />
            
            
            <Grid Width="250" Height="30">
            <!--<TextBlock Text="Пароль:"  HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>-->
            <PasswordBox x:Name="txtPassword" 
                         Height="30" Width="250" 
                         FontSize="18"
                         HorizontalAlignment="Center" 
                         Background="AliceBlue" BorderBrush="Gray" 
                         PasswordChanged="txtPassword_PasswordChanged"
                         Margin="0,0,0,0"/>
                <TextBlock x:Name="lblPasswordHint"
                           Text="Пароль"
                           Foreground="Gray"
                           Margin="2,0, 0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           FontSize="18"/>
            </Grid>
            
            
        </StackPanel>



        <StackPanel  Margin="0,2.5,0,3.5" HorizontalAlignment="Center" Grid.Row="2"  Width="250">

            <TextBlock Text="Пройдите Captcha:" 
                HorizontalAlignment="Center" 
                FontSize="18" 
                FontWeight="DemiBold"/>

            <Grid>
                <UniformGrid Name="PuzzleGrid" Rows="2" Columns="2" Height="135" Width="135" />
            </Grid>

            <!--<TextBox  x:Name="Captcha"  Height="20" Width="150" 
                      BorderBrush="Gray" Background="AliceBlue" 
                      Margin="0,5" />-->

        </StackPanel>

        <Button x:Name="LoginButton" Content="войти"  Grid.Row="3"
                FontWeight="Bold" Height="40" Width="150"  
                Background="LightYellow" Foreground="Aqua" BorderBrush="Gray"
                           FontSize="14" IsDefault="True" Margin="0,20,0,0" 
                    Click="LoginButton_Click"/>

        <Button x:Name="GetApiButton" Content="API"  Grid.Row="3" Grid.Column="1" 
               Background="LightYellow" Foreground="Aqua" BorderBrush="Gray" FontWeight="Bold"
                FontSize="15" Click="GetApiButton_Click" 
               Margin="10,20,10,0
                
                
                
                
                
                
                
                
                " />
    </Grid>
</Page>
